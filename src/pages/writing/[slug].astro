---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="prose">
    <p class="eyebrow">{formatDate(entry.data.date)}{entry.data.draft && ' · DRAFT'}</p>
    <h1>{entry.data.title}</h1>
    <Content />
    <p style="margin-top:3rem"><a href="/writing/">← All writing</a></p>
  </article>
</Base>
