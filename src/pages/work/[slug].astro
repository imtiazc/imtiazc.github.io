---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Metrics from '../../components/Metrics.astro';
import { getWork } from '../../lib';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <p class="eyebrow">{entry.data.org} · {entry.data.period}</p>
  <h1 class="prose">{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>
  <Metrics items={entry.data.metrics} />
  <article class="prose">
    <Content />
    <ul class="tags">{entry.data.stack.map((s) => <li>{s}</li>)}</ul>
    <p style="margin-top:3rem"><a href="/work/">← All case studies</a></p>
  </article>
</Base>
