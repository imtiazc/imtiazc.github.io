---
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="metrics">
      {items.map((m) => (
        <div class="metric">
          <b>{m.value}</b>
          <span>{m.label}</span>
        </div>
      ))}
    </div>
  )
}
